# Both bots on one Steam login (server/src/deadlock.mjs): Deadlock's match finder and the CS2 demo bot, which downloads,
# reads and grades demos with the app's own tools (so the whole repo is in the image). Built from the repo root:
#   fly deploy --config server/fly.toml --dockerfile server/Dockerfile.bots   (see server/DEADLOCK.md)
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
# not `npm ci`: the demo reader lists builds for systems that were never published (server/README.md)
RUN npm install --no-audit --no-fund && npm cache clean --force
COPY server/package.json server/package-lock.json server/
RUN cd server && npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY . .
ENV NODE_ENV=production DATA_DIR=/data PORT=8080
EXPOSE 8080
WORKDIR /app/server
CMD ["node", "src/deadlock.mjs"]
